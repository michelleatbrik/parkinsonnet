:root {
	--color-error: #dc2626;
}

.fui-form {
	align-items: start;

	.fui-row {
		display: flex;
		gap: var(--spacing-12);
		width: 100%;
		margin-bottom: 0px;
		align-items: stretch;
		flex-direction: column;

		@variant md {
			flex-direction: row;
		}
	}

	.fui-type-group {
		border: 1px solid var(--color-black);
		border-radius: 8px;
		padding: var(--spacing-12);
	}

	.fui-row > .fui-field {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		flex: 1 1 100%;

		@variant md {
			flex: 1;
		}
	}

	.fui-row > .fui-field > .fui-field-container {
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.fui-row > .fui-field .fui-input-wrapper {
		margin-top: auto;
	}

	.fui-row[data-fui-field-count='1'] > .fui-field {
		flex: 1 1 100%;
	}

	.fui-field {
		margin-bottom: 12px;
	}

	.fui-legend,
	.fui-label {
		font-size: var(--text-18);
		line-height: var(--leading-160);
		color: black;
		text-align: left;
		display: block;
		width: 100%;
		margin-bottom: var(--spacing-6);
		font-weight: 400;

		@variant md {
			margin-bottom: var(--spacing-12);
		}

		@variant lg {
			font-size: var(--text-20);
		}
	}

	.fui-row:not(.fui-row-empty):not(:last-child) {
		margin-bottom: 0px;
	}

	.fui-heading {
		font-family: var(--font-heading);
		line-height: var(--leading-120);
		color: var(--color-black);
		text-align: left;
		display: block;
		width: 100%;
		font-weight: 800;
	}

	.fui-heading h2,
	h2.fui-heading {
		font-size: var(--text-32);
		margin-top: var(--spacing-20);
	}

	.fui-heading h3,
	h3.fui-heading {
		font-size: var(--text-28);
		margin-bottom: var(--spacing-12);
	}

	.fui-heading h4,
	h4.fui-heading {
		font-size: var(--text-24);
		margin-bottom: var(--spacing-12);
	}

	.fui-heading h5,
	h5.fui-heading {
		font-size: var(--text-21);
		margin-bottom: var(--spacing-18);
	}

	.fui-heading h6,
	h6.fui-heading {
		font-size: var(--text-18);
		margin-bottom: var(--spacing-18);
	}

	.fui-row .fui-label[data-fui-sr-only] {
		visibility: hidden;
		height: 0;
		margin-bottom: var(--spacing-18);
		overflow: hidden;
	}

	.fui-fieldset > .fui-legend {
		display: none;
	}

	.fui-label-hidden .fui-label,
	.fui-field[data-label-position='hidden'] .fui-label,
	.fui-field[data-label-position='hidden'] label,
	[data-field-label-position='hidden'] .fui-label,
	[data-field-label-position='hidden'] label {
		display: none !important;
	}

	.fui-row .fui-label-hidden .fui-label[data-fui-sr-only],
	.fui-row .fui-field[data-label-position='hidden'] .fui-label[data-fui-sr-only] {
		display: block !important;
		visibility: hidden;
		height: 0;
		margin-bottom: 0;
	}

	.fui-input,
	input[type='text'],
	input[type='email'],
	input[type='tel'],
	textarea {
		border-radius: 0;
		width: 100%;
		background: white;
		border: none;
		border: 1px solid rgba(61, 61, 61, 0.3);
		padding: var(--spacing-4) var(--spacing-12);
		font-family: var(--font-sans);
		font-size: var(--text-18);
		line-height: var(--leading-160);
		color: var(--color-black);
		text-align: left;
		outline: none;
		height: 50px;
		border-radius: 8px;
		transition: border-color 0.2s ease-in-out;

		&::placeholder {
			color: var(--color-gray);
			opacity: 0.6;
		}

		&.fui-error {
			border-bottom-color: var(--color-error) !important;
		}

		@variant md {
			font-size: var(--text-21);
			padding: var(--spacing-12);
		}
	}

	.fui-select:not([multiple]):not([size]) {
		/*width: auto;*/
		border: 1px solid rgba(61, 61, 61, 0.3);
		border-radius: 8px;
		height: 50px;
		font-size: 1rem;
		background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='oklch(55.1%25 0.027 264.364)' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
	}

	.fui-select[multiple],
	.fui-select[size] {
		/*width: auto;*/
		border: 1px solid rgba(61, 61, 61, 0.3);
		height: 50px;
		border-radius: 8px;
		font-size: 1rem;
	}

	.fui-error-message {
		color: var(--color-error);
		font-size: var(--text-14);
		margin-top: var(--spacing-8);
		text-align: left;
	}

	.fui-submit-wrapper {
		margin-top: var(--spacing-12);
		width: 100%;
	}

	.fui-checkbox-wrapper,
	.fui-radio-wrapper {
		display: flex;
		align-items: flex-start;
		gap: var(--spacing-12);
		margin-bottom: var(--spacing-12);
		cursor: pointer;
	}

	input[type='checkbox'],
	input[type='radio'] {
		appearance: none;
		background: white;
		border-radius: 4px !important;
		width: 24px;
		height: 24px;
		border: 1px solid rgba(61, 61, 61, 0.3);
		cursor: pointer;
		position: relative;
		margin: 0 8px 0 0;
		padding: 0;
		transition: all 0.2s ease-in-out;

		&:hover {
			border-color: var(--color-black);
			opacity: 0.8;
		}

		&:focus {
			outline: 2px solid var(--color-black);
			outline-offset: 2px;
		}

		&:checked {
			background: var(--color-primary);
			border-color: var(--color-black);

			&::after {
				content: '';
				position: absolute;
			}
		}

		&.fui-error {
			border-color: var(--color-error);
		}
	}

	input[type='checkbox'] {
		border-radius: 0;

		&:checked::after {
			top: 3px;
			left: 8px;
			width: 6px;
			height: 12px;
			border: solid white;
			border-width: 0 2px 2px 0;
			transform: rotate(45deg);
		}
	}

	input[type='radio'] {
		border-radius: 50%;

		&:checked::after {
			top: 50%;
			left: 50%;
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background: white;
			transform: translate(-50%, -50%);
		}
	}

	.fui-checkbox-label,
	.fui-radio-label {
		font-family: var(--font-sans);
		font-size: var(--text-18);
		line-height: var(--leading-160);
		color: var(--color-black);
		cursor: pointer;
		padding-left: 0;
		margin: 0;
		flex: 1;
	}

	.fui-radio,
	.fui-checkbox {
		display: flex;
		align-items: start;

		label {
			&:before {
				display: none;
			}
		}
	}

	.fui-radio {
		display: flex;
		align-items: center;
	}

	.fui-type-checkboxes,
	.fui-type-radio {
		.fui-layout-wrap {
			display: flex;
			flex-direction: column;
			gap: var(--spacing-4);
		}
	}
}

.fui-alert-success,
.fui-alert-error {
	font-size: 1rem;
}

.fui-alert-error {
	background-color: rgba(220, 38, 38, 0.1);
	color: var(--color-error);
}
