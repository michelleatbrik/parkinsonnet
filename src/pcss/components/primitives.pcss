@theme inline {
	/* Trainingscentrum */
	--color-brand-100-trainingscentrum: #3babe1;
	--color-brand-300-trainingscentrum: #cbd5e1;
	--color-brand-600-trainingscentrum: #3babe1;

	/* Oefentherapie */
	--color-brand-100-oefentherapie: #17a3e6;
	--color-brand-300-oefentherapie: #7dcc49;
	--color-brand-600-oefentherapie: #fa921b;

	/* Semantics */
	--color-primary: var(--primary);
	--color-secondary: var(--secondary);
	--color-action: var(--action);
}

[data-theme='default'] {
	--primary: var(--color-brand-100-trainingscentrum);
	--secondary: var(--color-brand-300-trainingscentrum);
	--action: var(--color-brand-600-trainingscentrum);
}

[data-theme='oefentherapeut'] {
	--primary: var(--color-brand-100-oefentherapie);
	--secondary: var(--color-brand-300-oefentherapie);
	--action: var(--color-brand-600-oefentherapie);
}
