@theme {
	--spacing-*: initial;
	--spacing-0: 0;
	--spacing-1: calc(1 / 16 * 1rem);
	--spacing-2: calc(2 / 16 * 1rem);
	--spacing-3: calc(3 / 16 * 1rem);
	--spacing-4: calc(4 / 16 * 1rem);
