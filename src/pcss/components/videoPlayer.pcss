/*
  https://www.vidstack.io/docs/player/components/layouts/default-layout#css-variables
  https://www.vidstack.io/docs/player/components/layouts/plyr-layout?styling=default-theme
*/

:root {
	--video-brand: var(--color-primary);
	--audio-border-radius: 0.25rem;

	--plyr-color-main: var(--color-secondary);
	--plyr-video-control-color: var(--color-white);
	--video-border-radius: 0;
}

.plyr__control--overlaid {
	--plyr-video-control-color: var(--color-white);

	&:hover {
		--plyr-video-control-background-hover: var(--color-primary);
		--plyr-video-control-color-hover: var(--color-white);
	}
}

[data-media-player][data-layout='video']:not([data-fullscreen]) {
	border-radius: 24px !important;
	border: none !important;
}

[data-media-player] * {
	border-radius: 24px;
}
