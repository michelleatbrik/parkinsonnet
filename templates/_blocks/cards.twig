{% import '_macros/retcon.twig' as retcon %}

<div class="container bg-primary/10 flex flex-col gap-48">
    <div class="lg:w-3/5 flex flex-col gap-24">
        {% if block.preHeading|length %}
            <div class="uppercase text-20/120 font-bold text-primary ">{{ block.preHeading }}</div>
        {% endif %}
        {% include "_components/atoms/heading/heading.twig" with {
            htmlTag: "h2",
            text: block.title,
            size: "medium",
        } %}
    </div>
    <div class="grid grid-cols-3  gap-32">
        {% for card in block.cards.all() %}
            <div class="bg-white p-32 rounded-xl flex flex-col gap-16">
                {% set image = card.singleImage[0] %}
                {% include "_components/atoms/image/image.twig" with {
                    image: image,
                    transform: 'cardIcon',
                    alt: '',
                    imageClasses: 'size-96 object-contain',
                    wrapperClasses: 'w-96 shrink-0 mb-8',
                    sizes: '96px'
                } %}
                <div class="text-28/120 font-bold">{{ card.title }}</div>
                {% if card.text %}
                    {{ retcon.default(card.text) }}
                {% endif %}
                {% if card.button|length %}
                    <a href="{{card.button.url}}" class="text-action hover:text-primary font-semibold text-20/120">{{card.button.title}}</a>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>