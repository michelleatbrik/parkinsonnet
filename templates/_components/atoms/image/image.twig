
{# Image #}
{% set image = image ?? null %}
{% set imageMobile = imageMobile ?? null %}
{% set alt = alt ?? image.alt ?? image.title ?? '' %}

{# Settings #}
{% set transform = transform ?? 'default' %}
{% set mobileTransform = mobileTransform ?? transform %}
{% set loading = loading ?? 'lazy' %}
{% set fetchpriority = fetchpriority ?? 'auto' %}
{% set sizes = sizes ?? '(max-width: 768px) 100vw, 50vw' %}
{% set mobileSizes = mobileSizes ?? '100vw' %}
{% set densities = ['1x', '1.5x', '2x'] %}

{# Classes #}
{% set imageClasses = imageClasses ?? '' %}
{% set wrapperClasses = wrapperClasses ?? '' %}

{% if image %}

    {# Desktop WebP #}
    {% do image.setTransform({
        transform: transform,
        format: 'webp',
        quality: 80
    }) %}
    {% set desktopWebp = image.getSrcset(densities) %}

    {# Desktop fallback: JPG/PNG #}
    {% do image.setTransform(transform) %}
    {% set desktopFallback = image.getSrcset(densities) %}
    {% set fallbackUrl = image.url %}
    {% set imageWidth = image.width %}
    {% set imageHeight = image.height %}

    {# Mobile image (optional) #}
    {% if imageMobile %}

        {% do imageMobile.setTransform({
            transform: mobileTransform,
            format: 'webp',
            quality: 80
        }) %}
        {% set mobileWebp = imageMobile.getSrcset(densities) %}

        {% do imageMobile.setTransform(mobileTransform) %}
        {% set mobileFallback = imageMobile.getSrcset(densities) %}

    {% endif %}

    <div class="{{ wrapperClasses }}">
        <picture>

            {# Mobile #}
            {% if imageMobile %}
                <source
                    media="(max-width: 767px)"
                    type="image/webp"
                    srcset="{{ mobileWebp }}"
                    sizes="{{ mobileSizes }}"
                >

                <source
                    media="(max-width: 767px)"
                    srcset="{{ mobileFallback }}"
                    sizes="{{ mobileSizes }}"
                >
            {% endif %}

            {# Desktop WebP #}
            <source
                type="image/webp"
                srcset="{{ desktopWebp }}"
                sizes="{{ sizes }}"
            >

            {# JPG/PNG fallback #}
            <img
                src="{{ fallbackUrl }}"
                srcset="{{ desktopFallback }}"
                sizes="{{ sizes }}"
                width="{{ imageWidth }}"
                height="{{ imageHeight }}"
                alt="{{ alt }}"
                class="{{ imageClasses }}"
                loading="{{ loading }}"
                fetchpriority="{{ fetchpriority }}"
                decoding="async"
            >

        </picture>
    </div>

{% endif %}
