
{% set posterImage = posterImage|default(null) %}
{% set transform = transform|default('heroTextWithMediaHome') %}
{% set wrapperClasses = wrapperClasses|default('') %}
{% set controls = controls|default(true) %}

{% set posterUrl = posterImage ? posterImage.getUrl(transform) : null %}

{% set buttonClasses = 'absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10 grid place-items-center size-56 lg:size-64 rounded-full bg-primary text-white border-action hover:bg-action transition-colors duration-200 cursor-pointer' %}
{% set iconClasses = 'fill-current block size-16 lg:size-40 -mr-px' %}

<div
    x-data="{ isPlaying: false }"
    class="relative group overflow-hidden {{ wrapperClasses }}"
>
    <video
        x-ref="video"
        src="{{ video }}"
        {% if posterUrl %}poster="{{ posterUrl }}"{% endif %}
        x-bind:controls="isPlaying && {{ controls ? 'true' : 'false' }}"
        playsinline
        preload="metadata"
        class="block w-full aspect-video object-cover"
        @play="isPlaying = true"
        @pause="isPlaying = false"
        @ended="isPlaying = false"
    ></video>

    <button
        type="button"
        x-show="!isPlaying"
        @click="$refs.video.play()"
        aria-label="Video afspelen"
        class="{{ buttonClasses }}"
    >
        {{ inlineSvg('icons/play', iconClasses, {
            sanitize: true,
            namespace: true
        }) }}
    </button>
</div>
