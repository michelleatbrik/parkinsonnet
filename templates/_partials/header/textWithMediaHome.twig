{% import '_macros/retcon.twig' as retcon %}

{% set flagImage = flagImage|default(null) is not iterable ? (flagImage|default(null))|json_decode : flagImage %}
{% set partyItems = partyItems|default([]) %}
{% set relatedItems = relatedItems|default([]) %}

<div class="relative bg-primary/10">
    <div class="grid z-10 items-center container pt-48 lg:grid-cols-12 grid-cols-1 lg:gap-y-0 gap-y-32 gap-x-64">
        
        <figure class="lg:order-2 lg:col-span-6 relative aspect-[77-50] z-10">
            {% if entry.singleVideo|length %}
                {% set video = entry.singleVideo.one() %}

                {% include '_components/molecules/videoPlayer/videoPlayer.twig' with {
                    video: video.url,
                    posterImage: entry.singleImage.one() ?? null,
                    wrapperClasses: 'rounded-3xl',
                    controls: true,
                } %}
            {% elseif entry.singleImage|length %}
                {% set image = entry.singleImage[0] %}

                {% include "_components/atoms/image/image.twig" with {
                    image: image,
                    imageMobile: image,
                    transform: 'textWithMedia',
                    mobileTransform: 'textWithMedia',
                    imageClasses: 'w-full h-full object-cover rounded-3xl',
                    wrapperClasses: 'w-full',
                    loading: 'eager',
                    fetchpriority: 'high'
                } %}

            {% endif %}
        </figure>

        <div class="w-full lg:w-[95%] lg:col-span-6 relative lg:order-1 flex lg:items-start">
            <div class="flex flex-col gap-24">
                {% if entry.preHeading|length %}
                    <div class="uppercase text-20/120 font-bold text-primary ">{{ entry.preHeading }}</div>
                {% endif %}
                <div class="flex flex-row gap-16 items-center">    
                    {% include "_components/atoms/heading/heading.twig" with { htmlTag: "h1", text: entry.title, headingClasses: '', color: "black", size: "large", textTransform: ""  } only %}
                </div>
                {% if entry.intro|length %}
                    <div>
                        {{ retcon.intro(entry.intro) }}
                    </div>
                {% endif %}

                {% set buttons = entry.buttons.all() %}

                {% if buttons|length %}
                    <div class="flex flex-wrap gap-16">
                        {% for item in buttons %}
                            {% if item.button %}
                                {% include "_components/atoms/button/button.twig" with {
                                    url: item.button.url,
                                    text: item.button.title ?: (item.button.element ? item.button.element.title : item.button.url),
                                    target: item.button.target,
                                    theme: loop.first ? 'primary' : 'secondary',
                                } only %}
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>