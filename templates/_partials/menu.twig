{% set menuItems = menu.menuItems.all() %}

<header x-data="mobileMenu" class="lg:mb-[109px] mb-[83px]">
    <div class="w-full bg-white fixed top-0 z-[1300] border border-black/15">
        <div class="flex py-20 justify-between container items-center">

            {# Logo #}
            <a href="{{ currentSite.baseUrl }}" class="w-164">
                <img
                    class="w-164"
                    src="{{ currentSite.baseUrl }}/dist/img/logo/logo-parkinson.png"
                    alt="{{ siteName }}"
                >
            </a>

            {# Desktop navigatie #}
            <nav class="hidden lg:block">
                <ul class="flex items-center gap-32">
                    {% for item in menuItems %}
                        {% set page = item.menuPage.one() %}

                        {% if page %}
                            <li>
                                <a
                                    href="{{ page.url }}"
                                    class="text-18/120 font-medium hover:text-action"
                                    data-swup-preload
                                >
                                    {{ item.menuTitle ?: page.title }}
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </nav>

            {# Mobiele hamburger #}
            <button
                type="button"
                class="lg:hidden flex items-center justify-center size-40 cursor-pointer"
                @click="window.dispatchEvent(new Event('mobileMenu:toggle'))"
                :aria-expanded="isOpen.toString()"
                aria-controls="mobile-menu"
                :aria-label="isOpen ? 'Sluit menu' : 'Open menu'"
            >
                <span x-show="!isOpen">
                    {{ inlineSvg('icons/menu', 'size-24') }}
                </span>

                <span x-cloak x-show="isOpen">
                    {{ inlineSvg('icons/close', 'size-24') }}
                </span>
            </button>

        </div>
    </div>

    {# Mobiel menu #}
    {% block offcanvas %}
        {% include '_partials/offcanvas/mobileMenu.twig' with {
            menuItems: menuItems
        } %}
    {% endblock %}
</header>