{% set sites = currentSite.group.sites %}

<header x-data="mobileMenu" class="lg:mb-[109px] mb-[83px]">
    <div class="w-full bg-white fixed top-0 z-50 border border-black/15">
        <div class="flex lg:py-32 py-20 justify-between container ">
            <a class="block" aria-label="democrats" href="{{ currentSite.baseUrl }}">
                {{ inlineSvg('logo/logo-default-' ~ currentSite.language, 'text-primary lg:w-[240px] w-[190px]', { sanitize: true, namespace: true }) }}
            </a>

            <div class="flex flex-row xl:gap-24 gap-12 items-center">
                <ul class="flex-row xl:gap-24 gap-12 lg:flex hidden">
                    {% set nodes = craft.navigation.nodes('mainMenu').level(1).all() %}
                    {% for node in nodes %}
                        <li>
                        {% if node.children|length %}
                            <div class="inline-block relative cursor-pointer py-4 font-medium text-18/100 border-b-2 border-transparent hover:border-primary
                                {% if node.classes | length %}{{ node.classes }}{% endif %}
                                {% if node.active %}border-primary!{% endif %}
                                "
                                x-data="{ openDropdown: null }"
                                x-cloak
                                @mouseenter="openDropdown = {{ loop.index }}"
                                @mouseleave="if (openDropdown === {{ loop.index }}) openDropdown = null"
                                @focusin="openDropdown = {{ loop.index }}"
                                @focusout="if (!($el.contains($event.relatedTarget))) openDropdown = null"
                                @keydown.escape.window="openDropdown = null"
                            >
                                <div class="">
                                    <div
                                        class="cursor-pointer font-medium text-18/100 flex items-center flex-row gap-2"
                                        :aria-expanded="openDropdown === {{ loop.index }} ? 'true' : 'false'"
                                        aria-haspopup="true"
                                        @focus="openDropdown = {{ loop.index }}"
                                        @keydown.space.prevent="openDropdown = (openDropdown === {{ loop.index }}) ? null : {{ loop.index }}"
                                        @keydown.enter.prevent="openDropdown = (openDropdown === {{ loop.index }}) ? null : {{ loop.index }}">
                                        {{node.title}}
                                        <span :class="openDropdown === {{ loop.index }} ? 'rotate-180' : ''" class="border-[#262626] transition duration-150 ease-in-out">
                                            {{ inlineSvg('icons/chevron', 'size-16 ' ) }}
                                        </span>
                                    </div>
                                    <span x-show="openDropdown === {{ loop.index }}" class="absolute block left-1/2 -translate-x-1/2 top-full h-12 w-full"></span>
                                    <div x-transition:enter="duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="duration-300" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" x-show="openDropdown === {{ loop.index }}" class="absolute z-1020 w-max shadow-[0_4px_6px_-4px_rgba(0,0,0,0.06),0_10px_15px_-3px_rgba(0,0,0,0.06)] top-40 border flex gap-12 p-20 flex-col items-start border-[#E5E5E5] rounded-xl left-1/2 -translate-x-1/2 bg-white">
                                        {% for child in node.children %}
                                            <a href="{{child.url}}" {% if child.newWindow %} target="_blank" rel="noopener"{% endif %} class="hover:text-primary w-full block text-16/120">
                                                {{child.title}}
                                            </a>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <a 
                                {% if node.url %}href="{{ node.url }}"{% endif %}
                                {% if node.newWindow %} target="_blank" rel="noopener"{% endif %}
                                {% for attribute in node.customAttributes %}{{ attribute.attribute }}="{{ attribute.value }}"{% endfor %}
                                class="
                                    inline-block border-b-2 py-4 font-medium text-18/100 border-transparent hover:border-primary
                                    {% if node.classes | length %}{{ node.classes }}{% endif %}
                                    {% if node.active %}border-primary!{% endif %}
                                " 
                            >
                                <span>{{- node.title -}}</span>
                            </a>
                        {% endif %}
                        </li>
                    {% endfor %}
                </ul>

                <span class="h-32 w-1 bg-black/20 mr-1 lg:flex hidden"></span>
            
                <div x-data="{ languageDropdownIsOpen: false }" class="relative lg:flex hidden" @mouseenter="languageDropdownIsOpen = true" @mouseleave="languageDropdownIsOpen = false" @keydown.escape.window="languageDropdownIsOpen = false">
                    <button type="button" @click="languageDropdownIsOpen = !languageDropdownIsOpen" @keydown.enter.prevent="languageDropdownIsOpen = !languageDropdownIsOpen" @keydown.space.prevent="languageDropdownIsOpen = !languageDropdownIsOpen" :aria-expanded="languageDropdownIsOpen.toString()" aria-haspopup="true" class="cursor-pointer border-b-2 font-medium text-18/120 border-transparent hover:border-primary flex items-center flex-row gap-2">
                        {{ currentSite.language|upper }}

                        <span :class="languageDropdownIsOpen ? 'rotate-180' : ''">
                            {{ inlineSvg('/icons/chevron', 'size-16 fill-current text-black' ) }}
                        </span>
                    </button>
                    <span x-show="languageDropdownIsOpen" class="absolute block left-1/2 w-full -translate-x-1/2 top-full h-12"></span>
                    {% set currentSiteId = craft.app.sites.currentSite.id %}
                    {% set qs = craft.app.request.queryStringWithoutPath %}
                    {% set currentUrl = siteUrl(craft.app.request.pathInfo, qs) %}

                    <div x-cloak x-show="languageDropdownIsOpen" x-transition:enter="duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="duration-300" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="absolute w-max z-20 shadow-[0_4px_6px_-4px_rgba(0,0,0,0.06),0_10px_15px_-3px_rgba(0,0,0,0.06)] top-40 border gap-10 flex flex-col items-start border-[#E5E5E5] p-20 rounded-lg left-1/2 -translate-x-1/2 bg-white">
                        {% for site in sites %}
                            {% if site.hasUrls and site.id != currentSiteId %}
                                {% set localeUrl = currentUrl %}
                                {% set currentEntry = entry ?? null %}
                                {% set currentCategory = category ?? null %}

                                {% if currentEntry %}
                                    {% set localizedEntry = craft.entries()
                                        .id(currentEntry.canonicalId ?? currentEntry.id)
                                        .siteId(site.id)
                                        .status(null)
                                        .one()
                                    %}

                                    {% if localizedEntry %}
                                        {% set localeUrl = localizedEntry.url ~ (qs ? '?' ~ qs : '') %}
                                    {% endif %}

                                {% elseif currentCategory %}
                                    {% set localizedCategory = craft.categories()
                                        .id(currentCategory.canonicalId ?? currentCategory.id)
                                        .siteId(site.id)
                                        .status(null)
                                        .one()
                                    %}

                                    {% if localizedCategory %}
                                        {% set localeUrl = localizedCategory.url ~ (qs ? '?' ~ qs : '') %}
                                    {% endif %}
                                {% endif %}

                                <a class="text-black font-medium text-16/120 hover:text-primary" href="{{ localeUrl }}" lang="{{ site.language }}">
                                    {{ site.language|upper }}
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

                {% set searchIndex = craft.entries.section("indexes").type('searchIndex').one() %}
                {% if searchIndex %}
                    <a class="border-b-2 mt-2 lg:mt-0 lg:mr-0 mr-4 lg:order-none order-2 border-transparent hover:border-primary" type="button" aria-label="{{ 'Search'|t }}" href="{{ searchIndex.url }}">
                        {% include "_components/atoms/icon/icon.twig" with {
                            size: 'lg',
                            icon: 'search',
                            iconClasses: 'transition-all duration-300 text-black'
                        } %}
                    </a>
                {% endif %}

                {% if general.ctaMenu is defined and general.ctaMenu|length %}
                    {% set button = general.ctaMenu[0] %}
                    {% include "_components/atoms/button/button.twig" with {
                        htmlTag: 'a',
                        url: button.url,
                        text: button.text,
                        target: button.target,
                        icon: button.iconPicker,
                        theme: 'primary',
                        buttonClasses: '!hidden lg:!inline-flex',
                    } %}
                {% endif %}

                <div x-data="{ languageDropdownIsOpen: false }" class="relative lg:hidden flex" @keydown.escape.window="languageDropdownIsOpen = false">
                    <button type="button" @click="languageDropdownIsOpen = !languageDropdownIsOpen" @keydown.enter.prevent="languageDropdownIsOpen = !languageDropdownIsOpen" @keydown.space.prevent="languageDropdownIsOpen = !languageDropdownIsOpen" :aria-expanded="languageDropdownIsOpen.toString()" aria-haspopup="true" class="cursor-pointer border-b-2 mt-3 font-medium text-18/120 border-transparent hover:border-primary flex items-center flex-row gap-2">
                        {{ currentSite.language|upper }}

                        <span :class="languageDropdownIsOpen ? 'rotate-180' : ''">
                            {{ inlineSvg('/icons/chevron', 'size-16 fill-current text-black' ) }}
                        </span>
                    </button>
                    {% set currentSiteId = craft.app.sites.currentSite.id %}
                    {% set qs = craft.app.request.queryStringWithoutPath %}
                    {% set currentUrl = siteUrl(craft.app.request.pathInfo, qs) %}

                    <div x-cloak x-show="languageDropdownIsOpen" x-transition:enter="duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="duration-300" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="absolute w-max z-20 shadow-[0_4px_6px_-4px_rgba(0,0,0,0.06),0_10px_15px_-3px_rgba(0,0,0,0.06)] top-40 border gap-10 flex flex-col items-start border-[#E5E5E5] p-20 rounded-lg left-1/2 -translate-x-1/2 bg-white">
                        {% for site in sites %}
                            {% if site.hasUrls and site.id != currentSiteId %}
                                {% set localeUrl = currentUrl %}
                                {% set currentEntry = entry ?? null %}
                                {% set currentCategory = category ?? null %}

                                {% if currentEntry %}
                                    {% set localizedEntry = craft.entries()
                                        .id(currentEntry.canonicalId ?? currentEntry.id)
                                        .siteId(site.id)
                                        .status(null)
                                        .one()
                                    %}

                                    {% if localizedEntry %}
                                        {% set localeUrl = localizedEntry.url ~ (qs ? '?' ~ qs : '') %}
                                    {% endif %}

                                {% elseif currentCategory %}
                                    {% set localizedCategory = craft.categories()
                                        .id(currentCategory.canonicalId ?? currentCategory.id)
                                        .siteId(site.id)
                                        .status(null)
                                        .one()
                                    %}

                                    {% if localizedCategory %}
                                        {% set localeUrl = localizedCategory.url ~ (qs ? '?' ~ qs : '') %}
                                    {% endif %}
                                {% endif %}

                                <a class="text-black font-medium text-16/120 hover:text-primary" href="{{ localeUrl }}" lang="{{ site.language }}">
                                    {{ site.language|upper }}
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

                <div x-data="" class="lg:hidden order-last">
					<div @click="window.dispatchEvent(new Event('mobileMenu:toggle'));" class="">
						<span x-show="!isOpen">
							{{ inlineSvg('icons/menu', 'size-24 border-black ') }}
						</span>
						<span x-cloak x-show="isOpen">
							{{ inlineSvg('icons/close', 'size-24 border-black ') }}
						</span>
					</div>
				</div>

            </div>

        </div>
    </div>

    {% block offcanvas %}
		{% include '_partials/offcanvas/mobileMenu.twig' with {
			mainMenu: nodes
		} %}
	{% endblock %}
</header>
