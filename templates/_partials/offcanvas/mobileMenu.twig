
{% embed '_partials/offcanvas.twig' with { xdata: 'mobileMenu' } %}
    {% block content %}

        <div class="pt-[90px] flex flex-col justify-between">

            {# Mobiele navigatie #}
            <ul
                class="flex flex-col"
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0 -translate-x-2"
                x-transition:enter-end="opacity-100 translate-x-0"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100 translate-x-0"
                x-transition:leave-end="opacity-0 -translate-x-2"
            >
                {% for item in menuItems %}
                    {% set page = item.menuPage.one() %}

                    {% if page %}
                        <li class="border-b py-24 border-[#E5E5E5]">
                            <div class="flex px-24 text-18/120 items-center justify-between w-full">
                                <a
                                    href="{{ page.url }}"
                                    class="block w-full cursor-pointer hover:text-action transition-colors"
                                    data-swup-preload
                                >
                                    {{ item.menuTitle ?: page.title }}
                                </a>
                            </div>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>

            {# CTA + taalkeuze #}
            <div class="w-full relative flex flex-col gap-28 mt-36 px-24">

                {% if general.ctaMenu is defined and general.ctaMenu|length %}
                    {% set button = general.ctaMenu[0] %}

                    {% include "_components/atoms/button/button.twig" with {
                        htmlTag: 'a',
                        url: button.url,
                        text: button.text,
                        target: button.target,
                        icon: button.iconPicker,
                        theme: 'primary',
                    } %}
                {% endif %}

            </div>

        </div>

    {% endblock %}
{% endembed %}
